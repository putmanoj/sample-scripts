
# Load the complete external domain map structure at the http level
include /etc/nginx/conf.d/whitelist_domains.conf;

server {
    # Parameterised HTTP Server Port
    listen ${VSPHERE_PROXY_HTTP_PORT} default_server;
    server_name _;
    
    # FIXED: Explicitly appends your custom HTTPS port to the redirect target string
    # Redirect all external HTTP traffic to HTTPS
    return 301 https://$host:${VSPHERE_PROXY_HTTPS_PORT}$request_uri;
}

server {
    # Parameterised HTTPS Server Port
    listen ${VSPHERE_PROXY_HTTPS_PORT} ssl default_server;

    # Catch-all: accepts host IP, local network IP, or domain names
    server_name _;

    ssl_certificate /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    # LOAD EXTERNAL IP FIREWALL RULES
    include /etc/nginx/conf.d/whitelist_ips.conf;

    # Static HTML Route
    location / {
        # Block requests if they don't match the IP whitelist AND don't pass the domain check
        # If active, curl needs a matching Referer header to bypass this block
        if ($allow_domain = 0) {
            # Un-comment the line below if you want to drop requests not matching your domain list
            # return 403;
        }

        root /usr/share/nginx/html;
        index index.html;
    }

    # Route to VMware vCenter Simulator SOAP API
    location /sdk {
        proxy_pass https://vcsim-service:8989;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # FIXED: Prevent 504 Gateway Time-outs by increasing limits to 10 minutes
        proxy_connect_timeout       600s;
        proxy_send_timeout          600s;
        proxy_read_timeout          600s;
        send_timeout                600s;
    }

    # Apply the same timeout configurations to /rest, /pbm, and /api blocks

    location /rest {
        proxy_pass https://vcsim-service:8989;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /pbm {
        proxy_pass https://vcsim-service:8989;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /api {
        proxy_pass https://vcsim-service:8989;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
